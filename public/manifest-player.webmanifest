{
  "name": "Velocity Turf Player",
  "short_name": "VT Player",
  "description": "Velocity Turf Player App - Instant Turf Slot Booking, Community Matches, and Live Sports",
  "id": "velocity-turf-player",
  "start_url": "/player?source=pwa-player",
  "scope": "/player",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "dir": "ltr",
  "lang": "en-US",
  "background_color": "#0A192F",
  "theme_color": "#1769E8",
  "categories": ["sports", "fitness", "lifestyle"],
  "icons": [
    {
      "src": "/icons/player/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/player/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/player/icon-192x192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/player/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/player/icon-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Discover Turfs",
      "short_name": "Discover",
      "description": "Browse turfs and live slot booking",
      "url": "/player?tab=discover",
      "icons": [{ "src": "/icons/player/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Community Matches",
      "short_name": "Matches",
      "description": "Join open matches & pickup games",
      "url": "/player?tab=matches",
      "icons": [{ "src": "/icons/player/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Hub",
      "short_name": "My Hub",
      "description": "My booked slots & player QR passes",
      "url": "/player?tab=dashboard",
      "icons": [{ "src": "/icons/player/icon-192x192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
